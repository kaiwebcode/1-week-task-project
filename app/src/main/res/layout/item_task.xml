<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Checkbox / Toggle Circle -->
        <ImageView
            android:id="@+id/checkCircleImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Toggle Task Complete"
            android:src="@drawable/ic_circle_outline" />

        <!-- Title & Subtitle Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taskTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2D3436"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Prepare weekly report" />

            <TextView
                android:id="@+id/taskDescriptionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#636E72"
                android:textSize="12sp"
                tools:text="Review employee performance" />

        </LinearLayout>

        <!-- Status Pill Badge -->
        <TextView
            android:id="@+id/taskStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Pending"
            android:textColor="#FF7675"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 3-Dots Action Menu -->
        <ImageView
            android:id="@+id/moreMenuImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Task Options"
            android:src="@drawable/ic_more_vert" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
