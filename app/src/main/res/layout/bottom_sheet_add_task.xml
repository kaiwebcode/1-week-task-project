<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_plus"
                app:tint="#6C5CE7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add New Task"
                android:textColor="#2D3436"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Task Title Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Task Title *"
        android:textColor="#2D3436"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/titleEditText"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#F5F6FA"
        android:hint="Enter task title..."
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:paddingHorizontal="14dp"
        android:textColor="#2D3436"
        android:textColorHint="#B2BEC3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/titleCharCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:text="0/100"
        android:textColor="#B2BEC3"
        android:textSize="11sp" />

    <!-- Description Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Description (Optional)"
        android:textColor="#2D3436"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/descriptionEditText"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="#F5F6FA"
        android:gravity="top|start"
        android:hint="Add more details..."
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="250"
        android:padding="12dp"
        android:textColor="#2D3436"
        android:textColorHint="#B2BEC3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/descriptionCharCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:text="0/250"
        android:textColor="#B2BEC3"
        android:textSize="11sp" />

    <!-- Priority Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Priority"
        android:textColor="#2D3436"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Low Priority Pill -->
        <TextView
            android:id="@+id/priorityLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#F0EDFF"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="● Low"
            android:textColor="#6C5CE7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Medium Priority Pill (Default Selected) -->
        <TextView
            android:id="@+id/priorityMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="#FFF3E0"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="● Medium"
            android:textColor="#E65100"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- High Priority Pill -->
        <TextView
            android:id="@+id/priorityHigh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#FFE5E5"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="● High"
            android:textColor="#D63031"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Add Task Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitTaskButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#6C5CE7"
        android:text="Add Task"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_send"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF" />

</LinearLayout>
